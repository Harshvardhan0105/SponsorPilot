# SponsorPilot Configuration
# Crustdata REST API token (Required for LIVE mode)
CRUSTDATA_API_KEY=your_crustdata_api_key_here

# Runtime LLM API Key (Gemini API key for autonomous planning & grounded drafting)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default country filter (defaults to India)
DEFAULT_COUNTRY=India
